114,"words":[],"intro":[],"grammar":[],"sentences":[],"writing":[],"levels":0,"ready":false}],"words":{"w:你":{"id":"w:你","word":"你","pinyin":"nǐ","tones":[3],"meaning":"you","pos":["r"],"chars":["你"],"hsk2":1,"hsk3":1,"freq":5},"w:好":{"id":"w:好","word":"好","pinyin":"hǎo","tones":[3],"meaning":"good; well","pos":["a","d","v"],"chars":["好"],"hsk2":1,"hsk3":1,"freq":20},"w:你好":{"id":"w:你好","word":"你好","pinyin":"nǐ hǎo","tones":[3,3],"meaning":"hello","pos":[],"chars":["你","好"],"hsk2":null,"hsk3":null,"freq":null},"w:吗":{"id":"w:吗","word":"吗","pinyin":"má","tones":[2],"meaning":"(makes a statement into a yes-no question)","pos":["y"],"chars":["吗"],"hsk2":1,"hsk3":1,"freq":83},"w:我":{"id":"w:我","word":"我","pinyin":"wǒ","tones":[3],"meaning":"I; me","pos":["r"],"chars":["我"],"hsk2":1,"hsk3":1,"freq":3},"w:很":{"id":"w:很","word":"很","pinyin":"hěn","tones":[3],"meaning":"very","pos":["d"],"chars":["很"],"hsk2":1,"hsk3":1,"freq":35},"w:你们":{"id":"w:你们","word":"你们","pinyin":"nǐ men","tones":[3,0],"meaning":"you (more than one person)","pos":["r"],"chars":["你","们"],"hsk2":null,"hsk3":1,"freq":127},"w:不":{"id":"w:不","word":"不","pinyin":"bù","tones":[4],"meaning":"not","pos":["d"],"chars":["不"],"hsk2":1,"hsk3":1,"freq":9},"w:谢谢":{"id":"w:谢谢","word":"谢谢","pinyin":"xiè xie","tones":[4,0],"meaning":"thank you","pos":["v"],"chars":["谢","谢"],"hsk2":1,"hsk3":1,"freq":520},"w:不客气":{"id":"w:不客气","word":"不客气","pinyin":"bù kè qi","tones":[4,4,0],"meaning":"you're welcome","pos":[],"chars":["不","客","气"],"hsk2":1,"hsk3":1,"freq":16723},"w:对不起":{"id":"w:对不起","word":"对不起","pinyin":"duì bu qǐ","tones":[4,0,3],"meaning":"sorry","pos":["v"],"chars":["对","不","起"],"hsk2":1,"hsk3":1,"freq":1577},"w:没关系":{"id":"w:没关系","word":"没关系","pinyin":"méi guān xi","tones":[2,1,0],"meaning":"it doesn't matter; never mind","pos":["v"],"chars":["没","关","系"],"hsk2":1,"hsk3":1,"freq":3541},"w:再见":{"id":"w:再见","word":"再见","pinyin":"zài jiàn","tones":[4,4],"meaning":"goodbye","pos":["v"],"chars":["再","见"],"hsk2":1,"hsk3":1,"freq":2487},"w:叫":{"id":"w:叫","word":"叫","pinyin":"jiào","tones":[4],"meaning":"to be called","pos":["v","p","n"],"chars":["叫"],"hsk2":1,"hsk3":1,"freq":200},"w:什么":{"id":"w:什么","word":"什么","pinyin":"shén me","tones":[2,0],"meaning":"what","pos":["r"],"chars":["什","么"],"hsk2":1,"hsk3":1,"freq":55},"w:名字":{"id":"w:名字","word":"名字","pinyin":"míng zi","tones":[2,0],"meaning":"name","pos":["n"],"chars":["名","字"],"hsk2":1,"hsk3":1,"freq":829},"w:是":{"id":"w:是","word":"是","pinyin":"shì","tones":[4],"meaning":"to be","pos":["v"],"chars":["是"],"hsk2":1,"hsk3":1,"freq":4},"w:老师":{"id":"w:老师","word":"老师","pinyin":"lǎo shī","tones":[3,1],"meaning":"teacher","pos":["n"],"chars":["老","师"],"hsk2":1,"hsk3":1,"freq":799},"w:学生":{"id":"w:学生","word":"学生","pinyin":"xué sheng","tones":[2,0],"meaning":"student","pos":["n"],"chars":["学","生"],"hsk2":1,"hsk3":1,"freq":651},"w:呢":{"id":"w:呢","word":"呢","pinyin":"ne","tones":[0],"meaning":"(turns the question back: and you?)","pos":["y"],"chars":["呢"],"hsk2":1,"hsk3":1,"freq":96},"w:他":{"id":"w:他","word":"他","pinyin":"tā","tones":[1],"meaning":"he; him","pos":["r"],"chars":["他"],"hsk2":1,"hsk3":1,"freq":10},"w:她":{"id":"w:她","word":"她","pinyin":"tā","tones":[1],"meaning":"she; her","pos":["r"],"chars":["她"],"hsk2":1,"hsk3":1,"freq":38},"w:人":{"id":"w:人","word":"人","pinyin":"rén","tones":[2],"meaning":"person","pos":["n"],"chars":["人"],"hsk2":1,"hsk3":1,"freq":19},"w:中国":{"id":"w:中国","word":"中国","pinyin":"Zhōng guó","tones":[1,2],"meaning":"China","pos":["ns"],"chars":["中","国"],"hsk2":1,"hsk3":1,"freq":729}},"grammar":{"g:greetings-fixed":{"id":"g:greetings-fixed","title":"Greetings are fixed phrases","pattern":"你好 / 你们好","tip":"你好 is two words — 你 (you) and 好 (good) — but it is used as one set phrase. Say 你好 to one person and 你们好 to a group. There is no verb in it, and nothing changes for time of day.","unit":"b1l1","source":"authored","wikiRef":null,"wikiUrl":null,"page":null,"examples":[]},"g:ma-question":{"id":"g:ma-question","title":"Yes-no questions with 吗","pattern":"Statement + 吗？","tip":"Add 吗 to the end of a statement and it becomes a yes-no question. Nothing else moves. 你是老师 → 你是老师吗？","unit":"b1l1","source":"grammar-wiki","wikiRef":"ASGQ2AZA","wikiUrl":"https://resources.allsetlearning.com/chinese/grammar/ASGQ2AZA","page":16,"examples":["s:b1l1-03","s:b1l1-07","s:b1l1-08","s:b1l3-09","s:b1l3-10","s:b1l3-17"]},"g:hen-adjective":{"id":"g:hen-adjective","title":"Adjectives take 很, not 是","pattern":"Subject + 很 + Adjective","tip":"A Chinese adjective already works as the whole predicate, so you never put 是 in front of it. 我很好 is \"I am well\", not \"I am very well\" — plain 很 is closer to filler than to \"very\". Saying just 我好 sounds unfinished.","unit":"b1l1","source":"authored","wikiRef":"ASG17BLH","wikiUrl":"https://resources.allsetlearning.com/chinese/grammar/ASG17BLH","page":42,"examples":["s:b1l1-04","s:b1l1-06"]},"g:courtesy-pairs":{"id":"g:courtesy-pairs","title":"Courtesy phrases come in pairs","pattern":"谢谢 → 不客气 · 对不起 → 没关系","tip":"Each of these has an expected reply. Thanks (谢谢) is answered with 不客气, and an apology (对不起) with 没关系. You can add a person after 谢谢: 谢谢你, 谢谢你们.","unit":"b1l2","source":"authored","wikiRef":null,"wikiUrl":null,"page":null,"examples":["s:b1l2-02","s:b1l2-04","s:b1l2-06"]},"g:jiao-name":{"id":"g:jiao-name","title":"Asking a name with 叫","pattern":"Subject + 叫 + 什么名字","tip":"叫 means \"to be called\", and it takes the name directly — no 是. The question word 什么 sits exactly where the answer goes, so the word order never changes between question and answer.","unit":"b1l3","source":"grammar-wiki","wikiRef":"ASGUGWVZ","wikiUrl":"https://resources.allsetlearning.com/chinese/grammar/ASGUGWVZ","page":14,"examples":["s:b1l3-01","s:b1l3-02","s:b1l3-03"]},"g:question-word-place":{"id":"g:question-word-place","title":"Question words stay put","pattern":"Statement order, with 什么 in the answer's slot","tip":"Chinese does not move question words to the front. 你叫什么名字？has the same order as the answer 我叫马克. Find the slot you want filled, and drop 什么 into it.","unit":"b1l3","source":"grammar-wiki","wikiRef":"ASGJQPSC","wikiUrl":"https://resources.allsetlearning.com/chinese/grammar/ASGJQPSC","page":15,"examples":["s:b1l3-01"]},"g:shi-nouns":{"id":"g:shi-nouns","title":"Linking two nouns with 是","pattern":"Noun + 是 + Noun","tip":"是 joins two nouns: 他是老师. Use it only between nouns — never before an adjective, where 很 does the work instead. Negate it with 不: 我不是学生.","unit":"b1l3","source":"grammar-wiki","wikiRef":"ASGUN7RX","wikiUrl":"https://resources.allsetlearning.com/chinese/grammar/ASGUN7RX","page":16,"examples":["s:b1l3-04","s:b1l3-05","s:b1l3-06","s:b1l3-11"]},"g:bu-negation":{"id":"g:bu-negation","title":"Negating with 不","pattern":"Subject + 不 + Verb / Adjective","tip":"不 goes directly in front of whatever it negates: 不是, 不好. It covers the present and the future. Before a fourth-tone syllable it is said bú, as in 不客气.","unit":"b1l3","source":"grammar-wiki","wikiRef":"ASGIPYFV","wikiUrl":"https://resources.allsetlearning.com/chinese/grammar/ASGIPYFV","page":16,"examples":["s:b1l3-07","s:b1l3-08","s:b1l3-18"]},"g:ne-followup":{"id":"g:ne-followup","title":"Bouncing a question back with 呢","pattern":"Noun + 呢？","tip":"Once a question is on the table, 呢 asks it again about someone else without repeating it. 我很好，你呢？means \"I'm well — and you?\"","unit":"b1l3","source":"grammar-wiki","wikiRef":"ASGMJHZO","wikiUrl":"https://resources.allsetlearning.com/chinese/grammar/ASGMJHZO","page":24,"examples":["s:b1l3-13","s:b1l3-14"]}},"sentences":{"s:b1l1-01":{"id":"s:b1l1-01","unit":"b1l1","zh":"你好！","tokens":["你好"],"alt":[],"pinyin":"Nǐ hǎo!","en":"Hello!","enTokens":["Hello"],"enAlt":[],"grammar":[],"credit":null},"s:b1l1-02":{"id":"s:b1l1-02","unit":"b1l1","zh":"你们好！","tokens":["你们","好"],"alt":[],"pinyin":"Nǐmen hǎo!","en":"Hello, everyone!","enTokens":["Hello","everyone"],"enAlt":[],"grammar":[],"credit":null},"s:b1l1-03":{"id":"s:b1l1-03","