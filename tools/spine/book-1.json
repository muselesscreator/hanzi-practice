      "grammar": [
        {
          "id": "g:greetings-fixed",
          "title": "Greetings are fixed phrases",
          "pattern": "你好 / 你们好",
          "tip": "你好 is two words — 你 (you) and 好 (good) — but it is used as one set phrase. Say 你好 to one person and 你们好 to a group. There is no verb in it, and nothing changes for time of day.",
          "source": "authored"
        },
        {
          "id": "g:ma-question",
          "title": "Yes-no questions with 吗",
          "pattern": "Statement + 吗？",
          "tip": "Add 吗 to the end of a statement and it becomes a yes-no question. Nothing else moves. 你是老师 → 你是老师吗？",
          "wikiRef": "ASGQ2AZA",
          "page": 16,
          "source": "grammar-wiki"
        },
        {
          "id": "g:hen-adjective",
          "title": "Adjectives take 很, not 是",
          "pattern": "Subject + 很 + Adjective",
          "tip": "A Chinese adjective already works as the whole predicate, so you never put 是 in front of it. 我很好 is \"I am well\", not \"I am very well\" — plain 很 is closer to filler than to \"very\". Saying just 我好 sounds unfinished.",
          "source": "authored",
          "wikiRef": "ASG17BLH"
        }
      ],
