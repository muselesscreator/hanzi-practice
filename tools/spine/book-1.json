      ],
      "grammar": [
        {
          "id": "g:jiao-name",
          "title": "Asking a name with 叫",
          "pattern": "Subject + 叫 + 什么名字",
          "tip": "叫 means \"to be called\", and it takes the name directly — no 是. The question word 什么 sits exactly where the answer goes, so the word order never changes between question and answer.",
          "wikiRef": "ASGUGWVZ",
          "page": 14,
          "source": "grammar-wiki"
        },
        {
          "id": "g:question-word-place",
          "title": "Question words stay put",
          "pattern": "Statement order, with 什么 in the answer's slot",
          "tip": "Chinese does not move question words to the front. 你叫什么名字？has the same order as the answer 我叫马克. Find the slot you want filled, and drop 什么 into it.",
          "wikiRef": "ASGJQPSC",
          "page": 15,
          "source": "grammar-wiki"
        },
        {
          "id": "g:shi-nouns",
          "title": "Linking two nouns with 是",
          "pattern": "Noun + 是 + Noun",
          "tip": "是 joins two nouns: 他是老师. Use it only between nouns — never before an adjective, where 很 does the work instead. Negate it with 不: 我不是学生.",
          "wikiRef": "ASGUN7RX",
          "page": 16,
          "source": "grammar-wiki"
        },
        {
          "id": "g:bu-negation",
          "title": "Negating with 不",
          "pattern": "Subject + 不 + Verb / Adjective",
          "tip": "不 goes directly in front of whatever it negates: 不是, 不好. It covers the present and the future. Before a fourth-tone syllable it is said bú, as in 不客气.",
          "wikiRef": "ASGIPYFV",
          "page": 16,
          "source": "grammar-wiki"
        },
        {
          "id": "g:ne-followup",
          "title": "Bouncing a question back with 呢",
          "pattern": "Noun + 呢？",
          "tip": "Once a question is on the table, 呢 asks it again about someone else without repeating it. 我很好，你呢？means \"I'm well — and you?\"",
          "wikiRef": "ASGMJHZO",
          "page": 24,
          "source": "grammar-wiki"
        }
      ],
